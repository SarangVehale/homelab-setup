[Unit]
Description=Self-hosted audiobook server (built from source)
Requires=network.target
After=tailscale-online.target
Wants=tailscale-online.target

[Service]
Type=simple
User=audiobookshelf
Group=audiobookshelf
WorkingDirectory=/opt/audiobookshelf
ExecStart=/usr/bin/node /opt/audiobookshelf/index.js
Restart=always
Environment=NODE_ENV=production
Environment=HOST=__TAILSCALE_IP__
Environment=PORT=3333
Environment=CONFIG_PATH=/var/lib/audiobookshelf/config
Environment=METADATA_PATH=/var/lib/audiobookshelf/metadata

[Install]
WantedBy=multi-user.target
