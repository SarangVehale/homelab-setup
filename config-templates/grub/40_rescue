#!/bin/sh
# Adds a "boot with this repo's units masked" entry to the GRUB menu.
#
# Arch ships GRUB_DISABLE_RECOVERY=true. Setting it to false gets you GRUB's
# own, always-correct recovery entry (single-user / rescue.target) - that is
# handled in 13-boot-resilience.sh and is the primary safety net.
#
# This script adds the one thing GRUB cannot generate itself: an otherwise
# normal boot with only *this repo's* units masked. That is what isolates
# "which of my units is hanging boot" without also losing networking, the
# graphical session, or anything else a rescue shell drops.
#
# Fails safe: if the partition UUIDs cannot be determined, it emits nothing
# rather than a broken menu entry.

set -e

# shellcheck disable=SC1091
. /usr/share/grub/grub-mkconfig_lib

# grub-mkconfig_lib provides grub-probe as the ${grub_probe} VARIABLE, not
# as a command on PATH. Calling it bare silently fails, which made this
# script skip itself with "could not determine partition UUIDs".
: "${grub_probe:=$(command -v grub-probe 2>/dev/null || echo /usr/bin/grub-probe)}"

BOOT_UUID="$("${grub_probe}" --target=fs_uuid /boot 2>/dev/null || true)"
ROOT_UUID="$("${grub_probe}" --target=fs_uuid / 2>/dev/null || true)"
KERNEL="/vmlinuz-linux"
INITRD="/initramfs-linux.img"

# Match the stock entries and load CPU microcode first, if present. Omitting
# it does not stop the machine booting, but a troubleshooting entry should
# differ from a normal boot only in what it masks.
for uc in intel-ucode.img amd-ucode.img; do
    [ -r "/boot/$uc" ] && INITRD="/$uc $INITRD"
done

# /boot may be the same filesystem as /, in which case kernel paths are
# prefixed with /boot.
if [ "$BOOT_UUID" = "$ROOT_UUID" ]; then
    KERNEL="/boot${KERNEL}"
    INITRD="/boot${INITRD}"
fi

# Bail out silently rather than emit an entry that cannot boot.
if [ -z "$BOOT_UUID" ] || [ -z "$ROOT_UUID" ]; then
    echo "40_rescue: could not determine partition UUIDs, skipping" >&2
    exit 0
fi
if [ ! -r "/boot/vmlinuz-linux" ]; then
    echo "40_rescue: /boot/vmlinuz-linux not found, skipping" >&2
    exit 0
fi

# Units this repo installs that run at boot and could hang it.
MASK="systemd.mask=media-server-healthcheck.timer \
systemd.mask=media-server-healthcheck.service \
systemd.mask=media-server-backup.timer \
systemd.mask=media-server-backup.service \
systemd.mask=docker-network-fix.service \
systemd.mask=media-hdd-recover.service \
systemd.mask=media-hdd-disconnect.service"

cat <<ENTRY
menuentry 'Arch Linux — without homelab units (troubleshooting)' --class arch --class gnu-linux --class gnu --class os \$menuentry_id_option 'homelab-masked' {
	load_video
	set gfxpayload=keep
	insmod gzio
	insmod part_gpt
	insmod fat
	insmod ext2
	search --no-floppy --fs-uuid --set=root ${BOOT_UUID}
	echo 'Booting with homelab units masked...'
	linux ${KERNEL} root=UUID=${ROOT_UUID} rw ${MASK}
	initrd ${INITRD}
}
ENTRY
